{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recommend-book:native-protagonist-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_id",
    "input_hash",
    "model",
    "cli_version",
    "expression_id",
    "prompt_version",
    "task_version",
    "protagonist",
    "age",
    "profession"
  ],
  "properties": {
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "cli_version": {
      "type": "string",
      "minLength": 1
    },
    "expression_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": "string",
      "enum": [
        "3.0-native-definitions",
        "3.1-native-context"
      ]
    },
    "task_version": {
      "type": "string",
      "const": "native-protagonist-v3"
    },
    "protagonist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "name",
        "evidence",
        "unknown_reason"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "locator",
              "quote"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "age": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "evidence",
        "unknown_reason"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "child",
            "young",
            "adult",
            "mature",
            null
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "locator",
              "quote"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "profession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "evidence",
        "unknown_reason"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "locator",
              "quote"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
